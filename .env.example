# SMTP (self-hosted mail)
# For Vercel: add these same variables in Project Settings → Environment Variables
SMTP_HOST=mail.simplyfound.com.na
SMTP_PORT=587
SMTP_USER=mm@mindsandmanners.com
SMTP_PASS=your-mailbox-password

# Comma-separated recipients for discovery call form
DISCOVERY_NOTIFY_EMAILS=elmarie@onceuponmind.com

# Server port (3001 for dev API; use 8080 or 80 in production)
PORT=3001
